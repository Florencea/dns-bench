{
  "name": "electron-dns",
  "version": "1.0.0",
  "private": true,
  "description": "DNS and DoH benchmarking tool",
  "author": "Florencea Bear",
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "app:linux": "npm run build && electron-forge make --platform=linux",
    "app:mac": "npm run build && electron-forge make --platform=darwin",
    "app:pack": "npm run build && electron-forge package",
    "app:win": "npm run build && electron-forge make --platform=win32 --arch=x64",
    "build": "vite build --mode main && vite build --mode preload && vite build",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "lint:ci": "actionlint",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:e2e": "node scripts/smoke-test.ts",
    "test:main": "vitest run --project main",
    "test:renderer": "vitest run --project renderer",
    "test:setup": "playwright install chromium",
    "typecheck": "tsc -b --pretty false",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run app:pack && npm run test:e2e"
  },
  "allowScripts": {
    "fs-xattr@0.3.1": true,
    "fsevents": false,
    "macos-alias@0.2.12": true
  },
  "devDependencies": {
    "@adobe/react-spectrum": "3.47.7",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.108.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/eslint-plugin": "1.6.28",
    "electron": "45.4.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "prettier-plugin-packagejson": "3.1.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "zod": "4.6.7"
  }
}
